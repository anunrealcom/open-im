# =====================================================================
# Open IM (Qt6 / CMake) — Git 忽略规则
# 原则：源码、构建脚本、资源、文档入库；
#       编译产物、发布包、下载依赖、个人 IDE 配置不入库
# =====================================================================

# ---------------- 1. 构建输出目录 ----------------
build/
Build/
build-*/
cmake-build-*/
out/
_build/
/bin/
/obj/

# ---------------- 2. CMake 生成物 ----------------
CMakeFiles/
CMakeCache.txt
CMakeScripts/
cmake_install.cmake
install_manifest.txt
compile_commands.json
/Makefile
*.ninja
.ninja_*
Testing/
CTestTestfile.cmake
_deps/
/install/

# ---------------- 3. Qt 中间产物 ----------------
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
ui_*.h
*.moc
*_autogen/
a.out

# ---------------- 4. 编译中间文件 ----------------
*.o
*.obj
*.lo
*.slo
*.gch
*.pch
*.d
*.dwo
*.tlog
*.iobj
*.ipdb
*.idb
*.ilk
*.pdb
*.exp

# ---------------- 5. 链接产物 ----------------
*.exe
*.dll
*.so
*.so.*
*.dylib
*.a
*.lib
*.out
*.app/

# ---------------- 6. IDE / 编辑器个人配置 ----------------
.vs/
.idea/
*.user
*.user.*
.qtcreator/*.user
*.autosave
*.swp
*.swo
*~
Thumbs.db
Desktop.ini
.DS_Store

# ---------------- 7. 日志与临时文件 ----------------
*.log
*.tmp
*.bak
*.orig
*.rej

# ---------------- 8. 发布产物与打包工具（不入库） ----------------
# dist/          = windeployqt 收集出来的绿色版运行目录（含 Qt DLL）
# _nsis/         = 下载的 NSIS 安装器工具链
# *.zip / *.exe  = 绿色版压缩包与安装包
dist/
release/
_nsis/
*.zip
*.7z
*.rar
*.msi

# 注：打包"脚本"要入库，别误删——
#     installer.nsi / setup.sed / _diag.sed / dist_build.py / portable_zip.py
#     app.manifest / app.rc

# ---------------- 9. 一次性诊断目录 ----------------
_diag/
